DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pilot?schema=public"

JWT_ACCESS_SECRET="change-me-generate-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="change-me-generate-a-different-random-64-char-hex-string"

FRONTEND_ORIGIN="http://localhost:5173"

# Double authentification : clé de chiffrement du secret partagé avec
# l'application d'authentification de l'utilisateur. Une chaîne aléatoire d'au
# moins 32 caractères, par exemple `openssl rand -hex 32`.
#
# Sans cette variable, l'application fonctionne normalement mais l'activation
# de la double authentification est refusée avec un message explicite.
#
# Cette clé ne se perd pas et ne se remplace pas à la légère : les secrets déjà
# enregistrés deviendraient illisibles, et leurs titulaires devraient passer par
# un code de secours — dont les empreintes, elles, n'en dépendent pas.
# TWO_FACTOR_KEY="change-me-32-caracteres-aleatoires-au-moins"

# Stockage des fichiers : "local" (disque, par défaut) ou "s3" (S3-compatible :
# AWS S3, Cloudflare R2, Backblaze B2...). Recommandé en production, la plupart
# des hébergeurs cloud ayant un disque non persistant.
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
# S3_BUCKET="syneco-documents"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="change-me"
# S3_SECRET_ACCESS_KEY="change-me"

# Assistant IA (extraction structurée des documents + recherche en langage
# naturel) : optionnel. Sans cette clé, l'extraction retombe automatiquement
# sur le moteur heuristique et la recherche IA renvoie une erreur claire.
# ANTHROPIC_API_KEY="sk-ant-..."

# Paiement des abonnements (Stripe). Sans ces clés, l'application fonctionne
# normalement : seules les pages de souscription renvoient une erreur explicite.
# STRIPE_SECRET_KEY="sk_test_..."        # jamais la clé publique, jamais partagée
# STRIPE_WEBHOOK_SECRET="whsec_..."      # fourni à la création du webhook
# STRIPE_PRICE_PREMIUM="price_..."       # identifiant de tarif du plan Premium
# STRIPE_PRICE_PRO="price_..."           # identifiant de tarif du plan Professionnel

# Rappels d'échéance par e-mail : optionnel. Sans serveur SMTP, les rappels
# restent visibles dans l'application mais aucun e-mail ne part. Fonctionne
# avec n'importe quel fournisseur (Brevo, Mailjet, Outlook, Gmail...).
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"                        # 465 pour une connexion chiffrée d'emblée
# SMTP_USER="change-me"
# SMTP_PASSWORD="change-me"
# MAIL_FROM="SYNeco <rappels@syneco.pro>"  # doit être une adresse autorisée chez le fournisseur

# Déclenchement des rappels depuis l'extérieur : indispensable si l'instance
# s'endort (offres d'hébergement gratuites), le planificateur interne ne
# s'exécutant alors pas à l'heure dite. Un service de cron gratuit appelle
# POST /rappels/executer avec cet en-tête :
#   x-rappels-token: <la valeur ci-dessous>
# Sans cette variable, le point d'entrée reste fermé.
# REMINDERS_TRIGGER_TOKEN="chaine-aleatoire-longue-et-secrete"

# Notifications push : optionnel. Générer la paire une seule fois avec
# `npm run vapid` — en changer invaliderait tous les appareils déjà autorisés.
# VAPID_PUBLIC_KEY="B..."                  # transmise aux navigateurs
# VAPID_PRIVATE_KEY="change-me"            # secret, jamais dans le dépôt
# VAPID_SUBJECT="mailto:syneco.pro@outlook.fr"
