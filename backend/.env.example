DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pilot?schema=public"

JWT_ACCESS_SECRET="change-me-generate-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="change-me-generate-a-different-random-64-char-hex-string"

FRONTEND_ORIGIN="http://localhost:5173"

# Stockage des fichiers : "local" (disque, par défaut) ou "s3" (S3-compatible :
# AWS S3, Cloudflare R2, Backblaze B2...). Recommandé en production, la plupart
# des hébergeurs cloud ayant un disque non persistant.
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
# S3_BUCKET="syneco-documents"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="change-me"
# S3_SECRET_ACCESS_KEY="change-me"

# Assistant IA (extraction structurée des documents + recherche en langage
# naturel) : optionnel. Sans cette clé, l'extraction retombe automatiquement
# sur le moteur heuristique et la recherche IA renvoie une erreur claire.
# ANTHROPIC_API_KEY="sk-ant-..."

# Paiement des abonnements (Stripe). Sans ces clés, l'application fonctionne
# normalement : seules les pages de souscription renvoient une erreur explicite.
# STRIPE_SECRET_KEY="sk_test_..."        # jamais la clé publique, jamais partagée
# STRIPE_WEBHOOK_SECRET="whsec_..."      # fourni à la création du webhook
# STRIPE_PRICE_PREMIUM="price_..."       # identifiant de tarif du plan Premium
# STRIPE_PRICE_PRO="price_..."           # identifiant de tarif du plan Professionnel
