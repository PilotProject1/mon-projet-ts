generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  contrat
  facture
  assurance
  garantie
  courrier
  autre
}

enum DocumentStatus {
  traite
  en_attente
}

enum DeadlineStatus {
  a_faire
  terminee
}

enum Role {
  user
  admin
}

enum RenewalType {
  tacite
  manuel
  aucun
}

enum NotificationStatus {
  envoyee
  echouee
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(user)
  createdAt    DateTime @default(now())

  documents     Document[]
  deadlines     Deadline[]
  contracts     Contract[]
  notifications Notification[]
}

model Document {
  id        String         @id @default(cuid())
  name      String
  type      DocumentType
  fileKey   String
  mimeType  String
  sizeBytes Int
  status    DocumentStatus @default(en_attente)
  createdAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlines Deadline[]
  contracts Contract[]
}

model Deadline {
  id      String         @id @default(cuid())
  title   String
  dueDate DateTime
  status  DeadlineStatus @default(a_faire)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  notifications Notification[]
}

model Contract {
  id          String      @id @default(cuid())
  provider    String
  startDate   DateTime
  endDate     DateTime
  amount      Float
  renewalType RenewalType @default(aucun)
  createdAt   DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Notification {
  id      String             @id @default(cuid())
  channel String             @default("in_app")
  status  NotificationStatus @default(envoyee)
  message String
  sentAt  DateTime           @default(now())
  readAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlineId String
  deadline   Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
}
