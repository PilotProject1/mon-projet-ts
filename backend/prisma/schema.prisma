generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  contrat
  facture
  assurance
  garantie
  courrier
  autre
}

enum DocumentStatus {
  traite
  en_attente
}

enum DeadlineStatus {
  a_faire
  terminee
}

enum Role {
  user
  admin
}

enum Plan {
  gratuit
  premium
  pro
  pme
}

enum RenewalType {
  tacite
  manuel
  aucun
}

enum NotificationStatus {
  envoyee
  echouee
}

enum InvoiceStatus {
  brouillon
  envoyee
  payee
  en_retard
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(user)
  plan         Plan     @default(gratuit)
  createdAt    DateTime @default(now())

  // Facturation Stripe. Le plan reste la source de vérité côté application ;
  // ces champs servent à relier un compte à son abonnement.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  planRenewsAt         DateTime?
  // true lorsque l'abonnement est résilié mais court jusqu'à son échéance :
  // planRenewsAt désigne alors une date de fin, non de reconduction.
  planCancelAtPeriodEnd Boolean  @default(false)

  documents     Document[]
  deadlines     Deadline[]
  contracts     Contract[]
  notifications Notification[]
  shareLinks    ShareLink[]
  company       Company?
}

model Document {
  id        String         @id @default(cuid())
  name      String
  type      DocumentType
  fileKey   String
  mimeType  String
  sizeBytes Int
  status    DocumentStatus @default(en_attente)
  createdAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlines  Deadline[]
  contracts  Contract[]
  shareLinks ShareLink[]
}

model Deadline {
  id      String         @id @default(cuid())
  title   String
  dueDate DateTime
  status  DeadlineStatus @default(a_faire)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  notifications Notification[]
}

model Contract {
  id          String      @id @default(cuid())
  provider    String
  startDate   DateTime
  endDate     DateTime
  amount      Float
  renewalType RenewalType @default(aucun)
  createdAt   DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ShareLink {
  id         String    @id @default(cuid())
  token      String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  accesses ShareLinkAccess[]
}

model ShareLinkAccess {
  id         String   @id @default(cuid())
  accessedAt DateTime @default(now())

  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
}

model Company {
  id        String   @id @default(cuid())
  name      String
  legalInfo String?
  createdAt DateTime @default(now())

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  clients  Client[]
  invoices Invoice[]
}

model Client {
  id    String  @id @default(cuid())
  name  String
  email String
  phone String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoices Invoice[]
}

model Invoice {
  id      String        @id @default(cuid())
  number  String
  total   Float
  dueDate DateTime
  status  InvoiceStatus @default(brouillon)
  createdAt DateTime    @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
}

model Notification {
  id      String             @id @default(cuid())
  channel String             @default("in_app")
  status  NotificationStatus @default(envoyee)
  message String
  sentAt  DateTime           @default(now())
  readAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlineId String
  deadline   Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
}
