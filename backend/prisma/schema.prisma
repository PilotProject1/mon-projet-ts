generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  contrat
  facture
  assurance
  garantie
  courrier
  autre
}

enum DocumentStatus {
  traite
  en_attente
}

enum DeadlineStatus {
  a_faire
  terminee
}

enum Role {
  user
  admin
}

enum Plan {
  gratuit
  premium
  pro
  pme
}

enum RenewalType {
  tacite
  manuel
  aucun
}

enum NotificationStatus {
  envoyee
  echouee
}

enum InvoiceStatus {
  brouillon
  envoyee
  payee
  en_retard
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(user)
  plan         Plan     @default(gratuit)
  createdAt    DateTime @default(now())

  // Facturation Stripe. Le plan reste la source de vérité côté application ;
  // ces champs servent à relier un compte à son abonnement.
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  planRenewsAt          DateTime?
  // true lorsque l'abonnement est résilié mais court jusqu'à son échéance :
  // planRenewsAt désigne alors une date de fin, non de reconduction.
  planCancelAtPeriodEnd Boolean   @default(false)

  // Rappels d'échéance envoyés par e-mail. Désactivable par l'utilisateur ;
  // les rappels restent alors visibles dans l'application.
  reminderEmails Boolean @default(true)

  /// Point hebdomadaire par e-mail : ce qui demande une décision. Distinct
  /// des rappels d'échéance, et refusable séparément — les deux ne rendent
  /// pas le même service et ne s'acceptent pas ensemble.
  weeklyDigest       Boolean   @default(true)
  /// Dernier point parti. Garantit qu'il ne part qu'une fois par semaine, et
  /// rattrape une semaine où la tournée n'a pas eu lieu.
  lastWeeklyDigestAt DateTime?

  /// Double authentification par code à usage unique (TOTP, RFC 6238).
  /// Une date plutôt qu'un booléen : elle vaut activation, et se montre à
  /// l'utilisateur, qui a le droit de savoir depuis quand son compte est
  /// protégé.
  twoFactorEnabledAt     DateTime?
  /// Secret partagé avec l'application d'authentification. Chiffré par
  /// l'application avant d'atteindre la base : un vidage de la base ne suffit
  /// pas à fabriquer des codes.
  twoFactorSecret        String?
  /// Secret d'une activation commencée mais pas encore confirmée par un
  /// premier code. Séparé du précédent pour qu'une préparation abandonnée —
  /// mauvaise application, téléphone qui s'éteint — ne coupe jamais l'accès à
  /// un compte déjà protégé.
  twoFactorPendingSecret String?
  /// Dernier pas de temps accepté (RFC 6238). Un code déjà présenté est
  /// refusé pendant le reste de sa validité : lu par-dessus l'épaule, il ne
  /// sert plus à rien.
  twoFactorLastStep      Int?

  /// Jeton de l'adresse de dépôt par e-mail : depot-<jeton>@depot.syneco.pro.
  ///
  /// C'est un secret, au même titre qu'un mot de passe — l'expéditeur d'un
  /// courriel se falsifie en trois lignes, et seule cette part inconnue de
  /// l'adresse empêche d'écrire dans le coffre de quelqu'un d'autre. Il se
  /// régénère à volonté ; l'ancienne adresse cesse alors immédiatement de
  /// fonctionner.
  ///
  /// Nul tant que la personne n'a pas demandé son adresse : on n'ouvre pas
  /// une porte que personne n'a réclamée.
  inboundToken String? @unique

  documents         Document[]
  deadlines         Deadline[]
  contracts         Contract[]
  notifications     Notification[]
  shareLinks        ShareLink[]
  pushSubscriptions PushSubscription[]
  recoveryCodes     TwoFactorRecoveryCode[]
  company           Company?
}

model Document {
  id        String         @id @default(cuid())
  name      String
  type      DocumentType
  fileKey   String
  mimeType  String
  sizeBytes Int
  status    DocumentStatus @default(en_attente)
  createdAt DateTime       @default(now())

  /// Échéance repérée dans le texte du document et proposée à l'utilisateur.
  /// Effacée dès qu'il l'accepte ou l'écarte : une proposition n'a de sens
  /// que tant qu'elle n'a pas été tranchée.
  suggestedDueDate  DateTime?
  suggestedDueLabel String?

  /// Ce que la lecture du document a appris de lui. Ces champs étaient déjà
  /// calculés à chaque analyse puis jetés ; les conserver est ce qui permet
  /// de répondre à « combien ai-je payé chez X », « où est ma facture de
  /// février » sans relire tous les fichiers.
  provider       String?
  amount         Float?
  /// Date portée par le document lui-même — émission, établissement — par
  /// opposition à createdAt, qui n'est que le jour du dépôt.
  documentDate   DateTime?
  /// Référence propre au document — numéro de facture, de contrat, de police,
  /// ou identifiant client. C'est ce qu'un service client réclame au
  /// téléphone, et ce qu'on ne retrouve jamais dans une pile de papiers.
  reference      String?
  /// Intitulé qui a désigné cette référence, pour qu'on sache de laquelle il
  /// s'agit : un numéro de facture ne vaut pas un identifiant client.
  referenceLabel String?
  /// Vrai si le document se déclare acquitté, faux s'il annonce un règlement
  /// à venir, null si rien ne tranche. Une facture déjà prélevée n'appelle
  /// aucun rappel : proposer une échéance dessus ne ferait qu'agacer.
  paid           Boolean?
  /// Texte lu dans le document, tronqué. Sert la recherche par le contenu.
  extractedText  String?
  /// Dernière lecture réussie. Distingue « rien trouvé » de « jamais lu »,
  /// et permet de rattraper les documents déposés avant cette version.
  analyzedAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlines  Deadline[]
  contracts  Contract[]
  shareLinks ShareLink[]

  @@index([userId, analyzedAt])
}

model Deadline {
  id      String         @id @default(cuid())
  title   String
  dueDate DateTime
  status  DeadlineStatus @default(a_faire)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  notifications Notification[]
}

model Contract {
  id          String      @id @default(cuid())
  provider    String
  startDate   DateTime
  endDate     DateTime
  amount      Float
  renewalType RenewalType @default(aucun)
  createdAt   DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  accesses ShareLinkAccess[]
}

model ShareLinkAccess {
  id         String   @id @default(cuid())
  accessedAt DateTime @default(now())

  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
}

model Company {
  id        String   @id @default(cuid())
  name      String
  legalInfo String?
  createdAt DateTime @default(now())

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  clients  Client[]
  invoices Invoice[]
}

model Client {
  id    String  @id @default(cuid())
  name  String
  email String
  phone String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoices Invoice[]
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  total     Float
  dueDate   DateTime
  status    InvoiceStatus @default(brouillon)
  createdAt DateTime      @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
}

model Notification {
  id      String             @id @default(cuid())
  channel String             @default("in_app")
  status  NotificationStatus @default(envoyee)
  message String
  sentAt  DateTime           @default(now())
  readAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlineId String
  deadline   Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)

  // Nombre de jours restant avant l'échéance au moment du rappel automatique.
  // null pour un rappel déclenché à la main, qui reste donc répétable :
  // PostgreSQL considère deux NULL comme distincts dans un index unique.
  offsetDays Int?

  // Garantit qu'une même échéance ne déclenche qu'un seul rappel par palier,
  // même si la tournée est rejouée ou si deux instances tournent en parallèle.
  @@unique([deadlineId, offsetDays])
}

/// Un navigateur ayant accepté de recevoir des notifications. L'existence de
/// cette ligne vaut consentement : la retirer suffit à ne plus être notifié.
model PushSubscription {
  id        String   @id @default(cuid())
  /// Adresse fournie par le service de notification du navigateur.
  endpoint  String   @unique
  /// Clés de chiffrement du destinataire : le serveur ne peut pas lire ce
  /// qu'il envoie sans elles, et elles ne servent qu'à cet envoi.
  p256dh    String
  auth      String
  /// Aide l'utilisateur à reconnaître l'appareil dans la liste.
  label     String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Code de secours de la double authentification.
///
/// Conservé sous forme d'empreinte bcrypt, exactement comme un mot de passe :
/// la base ne permet pas de les relire, et l'utilisateur ne les voit qu'une
/// fois, au moment où ils sont créés. Chacun ne sert qu'une seule fois — d'où
/// `usedAt`, qui garde la trace de celui qui a servi plutôt que d'effacer la
/// ligne : savoir qu'un code a été consommé, et quand, vaut mieux que de le
/// voir disparaître sans explication.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
