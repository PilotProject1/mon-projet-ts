{
  "name": "SYNeco — documents et échéances",
  "short_name": "SYNeco",
  "description": "Conservez vos documents administratifs, suivez leurs échéances et recevez un rappel avant expiration.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f5f8f7",
  "theme_color": "#0b2e2f",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Photographier un document",
      "short_name": "Photographier",
      "description": "Prendre un document en photo : il est recadré et nettoyé automatiquement.",
      "url": "/documents?scan=1",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mes échéances",
      "short_name": "Échéances",
      "url": "/echeances",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/partage-recu",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "files": [
        {
          "name": "fichiers",
          "accept": [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        }
      ]
    }
  }
}
